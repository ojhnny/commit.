# Copy to .env for local runs without Docker (docker compose sets these itself).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commit
# Comma-separated web origins allowed to call the API (your Vercel URL in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to false after you create your account so nobody else can sign up.
ALLOW_SIGNUP=true
SESSION_DAYS=60
